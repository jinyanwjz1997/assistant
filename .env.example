# 本文件只声明变量名和示例格式，禁止填写并提交真实密钥。
DEEPSEEK_API_KEY=replace-with-your-new-api-key

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/interview_jinyan?currentSchema=jinyan&reWriteBatchedInserts=true
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-database-password
DB_JPA_BATCH_SIZE=100
DB_BATCH_PARALLELISM=4
DB_BATCH_SIZE=100
DB_BATCH_QUEUE_CAPACITY=100
DB_BATCH_MAX_RECORDS=10000

# 可选覆盖项
REDIS_URL=redis://127.0.0.1:6379
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_MAX_TOKENS=100000
DEEPSEEK_SUMMARY_MODEL_NAME=deepseek-chat
DEEPSEEK_SUMMARY_MAX_TOKENS=1024
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Elasticsearch
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-your-elasticsearch-password
ELASTICSEARCH_INDEX_NAME=assistant_documents
